BACKEND_API_URL=https://URL-DO-BACKEND.onrender.com/api
OPERATOR_TOKEN=token_seguro
CLIENT_ID=id_do_cliente
CLIENT_SLUG=slug-do-cliente
CAMERA_ID=campo-01
# Opcional: se ficar vazio, o capture-server busca a URL RTSP no backend.
LOCAL_RTSP_URL=rtsp://usuario:senha@192.168.0.6:554/onvif1
# Opcional: usado pelo iniciar-sistema.bat para abrir a tela do operador.
OPERATOR_URL=https://URL-DO-FRONTEND.vercel.app/teste
RTSP_TRANSPORT=auto
BUFFER_VIDEO_CODEC=libx264
BUFFER_FPS=30
DEFAULT_REPLAY_SECONDS=15
REPLAY_VIDEO_CODEC=libx264
FAST_REPLAY_COPY=true
SEGMENT_TIME_SECONDS=1
SEGMENT_WRAP_COUNT=120
POLL_INTERVAL_SECONDS=1
