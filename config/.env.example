SEGMENT_TIME_SECONDS=2
SEGMENT_WRAP_COUNT=120
DEFAULT_REPLAY_SECONDS=15
CAMERA_CONNECT_TIMEOUT_SECONDS=10
RECORDER_MAX_RESTARTS=5
