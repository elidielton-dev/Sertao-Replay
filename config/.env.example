APP_NAME=Sports Replay MVP
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./sports_replay.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OPERATOR_TOKEN=troque-este-token

CAMERAS_CONFIG_PATH=../config/cameras.json
REPLAY_ROOT=./storage/replays
LOG_ROOT=./storage/logs

DEFAULT_REPLAY_SECONDS=15

# WebRTC/WHEP para a rota /streaming.
# Base padrao: https://SEU-GATEWAY-WEBRTC/campo-01/whep
WEBRTC_WHEP_BASE_URL=
# Ou mapeie cameras para caminhos diferentes:
# WEBRTC_WHEP_URL_MAP=campo-01=https://SEU-GATEWAY-WEBRTC/camera1/whep
